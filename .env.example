# Copy to .env.local and fill in. Never commit .env.local.

# Canonical site origin — used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics measurement ID (G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Added as integrations land:
# CMS_*        — headless CMS project/token
# STRIPE_*     — payments
# EMAIL_*      — transactional email
