# Copy to .env.local and fill in. Never commit .env.local.

# Canonical site origin — used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to show the placeholder customer quotes on a deployed preview,
# for showing the client the design. Never set this in Production — publishing
# invented reviews has been illegal in the UK since the DMCC Act 2024.
NEXT_PUBLIC_SHOW_EXAMPLE_REVIEWS=

# Google Analytics measurement ID (G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Sanity. Both are publishable values, not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=mxc2ll2l
NEXT_PUBLIC_SANITY_DATASET=production

# Stripe. Test keys in development and preview, live keys only in production —
# never mixed. The secret and webhook secret are unprefixed so they stay
# server-only; anything NEXT_PUBLIC_ is visible in the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend, for order notifications and the contact form. Without the key the
# site still works: orders are recorded by Stripe and the contact form points
# the customer at the email address instead.
RESEND_API_KEY=
# Must sit on a domain verified in Resend. Leave blank to use Resend's shared
# sending domain, which is fine for testing.
EMAIL_FROM="Efamy <orders@efamys.co.uk>"
