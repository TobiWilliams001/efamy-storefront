# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Local agent tooling
.claude/

# Stock comps awaiting a licence. Never commit or serve these.
unlicensed-assets/

# Unsorted image drops. Files are renamed into public/products, public/dishes
# etc. once identified; the originals should not ship in every deploy.
/public/ChatGPT Image*
/public/WhatsApp Image*
/public/photos-src/
